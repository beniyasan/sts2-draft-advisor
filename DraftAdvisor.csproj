<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DraftAdvisor</AssemblyName>
    <RootNamespace>DraftAdvisor</RootNamespace>
    <!--
      Point at the game's data folder containing sts2.dll / GodotSharp.dll / 0Harmony.dll.
      Resolution order:
        1. -p:Sts2DataDir=... on the command line
        2. STS2_DATA_DIR environment variable
        3. ./lib/sts2.dll (drop the three game DLLs into ./lib)
        4. Default Steam install path (Windows or Proton/Linux layout)
    -->
    <Sts2DataDir Condition="'$(Sts2DataDir)' == '' and '$(STS2_DATA_DIR)' != ''">$(STS2_DATA_DIR)</Sts2DataDir>
    <Sts2DataDir Condition="'$(Sts2DataDir)' == '' and Exists('$(MSBuildProjectDirectory)/lib/sts2.dll')">$(MSBuildProjectDirectory)/lib</Sts2DataDir>
    <Sts2DataDir Condition="'$(Sts2DataDir)' == '' and Exists('C:/Program Files (x86)/Steam/steamapps/common/Slay the Spire 2/data_sts2_windows_x86_64/sts2.dll')">C:/Program Files (x86)/Steam/steamapps/common/Slay the Spire 2/data_sts2_windows_x86_64</Sts2DataDir>
    <Sts2DataDir Condition="'$(Sts2DataDir)' == '' and Exists('$(HOME)/.steam/steam/steamapps/common/Slay the Spire 2/data_sts2_linux_x86_64/sts2.dll')">$(HOME)/.steam/steam/steamapps/common/Slay the Spire 2/data_sts2_linux_x86_64</Sts2DataDir>
  </PropertyGroup>

  <Target Name="ValidateGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(Sts2DataDir)' == '' or !Exists('$(Sts2DataDir)/sts2.dll')"
           Text="sts2.dll not found. Copy sts2.dll, GodotSharp.dll and 0Harmony.dll from 'Slay the Spire 2/data_sts2_&lt;platform&gt;/' into ./lib, or set STS2_DATA_DIR." />
  </Target>

  <ItemGroup>
    <!-- compile-check/ is a local-only stub project; never part of the mod. -->
    <Compile Remove="compile-check/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(Sts2DataDir)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(Sts2DataDir)/GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
